+class LeaseConflict(Exception):
+    """Another human viewer already holds the lease (non-preemptive claim)."""
+
+    def __init__(self, lease: Lease):
+        super().__init__("another viewer holds the display")
+        self.lease = lease
+
+
+def acquire_if_free(viewer_id: str, *, profile_key: Optional[str] = None, reason: str = "") -> Lease:
+    """Take control only when no OTHER human holds it.
+
+    The read of the current holder and the write of the new holder happen under the
+    same per-profile file lock (``_locked``), so two viewers racing an acquire
+    cannot both succeed: the loser gets :class:`LeaseConflict` carrying the
+    authoritative lease and never mutates it. Re-acquiring as the current holder is
+    idempotent (no epoch bump)."""
+    key, path = hermes_home_key(profile_key) if profile_key else hermes_home_key(), _path(profile_key)
+    with _locked(path):
+        lease = _read(path)
+        if lease.holder == HUMAN and lease.viewer_id is not None and lease.viewer_id != viewer_id:
+            raise LeaseConflict(lease)
+        changed = not (lease.holder == HUMAN and lease.viewer_id == viewer_id)
+        if changed:
+            # The agent's ask ("please log in to X") stays as the takeover reason.
+            lease.holder, lease.viewer_id, lease.since = HUMAN, viewer_id, time.time()
+            lease.reason = reason or ""
+            lease.epoch += 1
+            _write(path, lease)
+    if changed:
+        with _lock:
+            _lock.notify_all()
+        _notify(key, lease)
     return lease
 
 
